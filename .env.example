# Signup storage — Supabase (free tier).
#
# Setup:
#   1. Create a free project at https://supabase.com
#   2. Run supabase/schema.sql in the SQL Editor
#   3. Settings → API → copy the values below
#   4. Save this file as .env.local (it is gitignored), and add the same two
#      variables to your Vercel project's Environment Variables
#
# The service role key bypasses Row Level Security. It is used only inside the
# /api/signup route handler and is never exposed to the browser — do not rename
# it with a NEXT_PUBLIC_ prefix and do not commit it.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Without these, `npm run dev` falls back to writing submissions to
# .data/signups.json so the form can be tested locally. In production the API
# returns an error instead of silently dropping a signup.

# Password for the /admin signups panel. Set this in Vercel only — never commit
# a real value, and never rename it with a NEXT_PUBLIC_ prefix, which would ship
# it to every visitor's browser. Changing it signs out all existing sessions.
#
# It must be at least 20 characters or the panel stays disabled: rate limiting
# only slows an online guessing attack, password entropy is what stops it.
# Generate one with: openssl rand -base64 32
ADMIN_PASSWORD=choose-a-long-random-password

# Canonical site URL, used for Open Graph and canonical link tags.
NEXT_PUBLIC_SITE_URL=https://www.zentichealth.co.uk
